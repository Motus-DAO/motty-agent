{
  "name": "@motusdao/motty",
  "version": "0.1.1",
  "description": "Reusable Motty agent \u2014 lightweight MCP knowledge guide with optional funnel tools, signed sessions, and auth/progress adapters.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./mock": {
      "types": "./dist/adapters/mock.d.ts",
      "import": "./dist/adapters/mock.js"
    },
    "./styles.css": "./src/react/motty.css"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/core/namespaces.test.ts src/core/payments.test.ts src/mcp/protocol.test.ts",
    "mcp": "node dist/mcp/server.js",
    "a2a": "node dist/a2a/server.js"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18",
    "react-markdown": ">=9"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MotusDAO/motty-agent.git"
  },
  "keywords": [
    "motusdao",
    "motty",
    "mcp",
    "agent",
    "venice"
  ],
  "dependencies": {
    "@celo/attribution-tags": "^0.5.0",
    "viem": "^2.57.17"
  }
}
